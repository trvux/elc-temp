                  "text": "Thiết bị Menred chính hãng, đầy đủ CO/CQ.",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "type": "listItem",
          "content": [
            {
              "type": "paragraph",
              "content": [
                {
                  "text": "Kỹ thuật lắp đặt đạt chuẩn thẩm mỹ kiến trúc cao cấp.",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "type": "listItem",
          "content": [
            {
              "type": "paragraph",
              "content": [
                {
                  "text": "Hỗ trợ kỹ thuật nhanh chóng, tận tâm 24/7.",
                  "type": "text"
                }
              ]
            }
          ]
        }
      ]
    },
    {
      "type": "paragraph",
      "content": [
        {
          "text": "Bạn đang cần giải pháp không khí chuẩn sạch cho căn hộ cao cấp?",
          "type": "text",
          "marks": [
            {
              "type": "bold"
            }
          ]
        },
        {
          "text": " Liên hệ ngay với ",
          "type": "text"
        },
        {
          "text": "Điện máy ELC",
          "type": "text",
          "marks": [
            {
              "type": "bold"
            }
          ]
        },
        {
          "text": " để nhận tư vấn và khảo sát hiện trạng miễn phí!",
          "type": "text"
        }
