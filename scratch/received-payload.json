    {
      "type": "paragraph",
      "content": [
        {
          "text": "Kết quả nghiệm thu & Đánh giá",
          "type": "text",
          "marks": [
            {
              "type": "bold"
            }
          ]
        }
      ]
    },
    {
      "type": "paragraph",
      "content": [
        {
          "text": "Sau khi bàn giao vào tháng 1/2026, dự án đã nhận được sự hài lòng tuyệt đối từ chủ đầu tư:",
          "type": "text"
        }
      ]
    },
    {
      "type": "bulletList",
      "content": [
        {
          "type": "listItem",
          "content": [
            {
              "type": "paragraph",
              "content": [
                {
                  "text": "Vẻ đẹp tinh tế:",
                  "type": "text",
                  "marks": [
                    {
                      "type": "bold"
                    }
                  ]
                },
                {
                  "text": " Toàn bộ máy móc được xử lý giấu kín, chỉ để lại những đường nét cửa gió sang trọng trên trần nhà.",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "type": "listItem",
          "content": [
            {
              "type": "paragraph",
              "content": [
                {
                  "text": "Môi trường sống lý tưởng:",
                  "type": "text",
                  "marks": [
                    {
                      "type": "bold"
                    }
                  ]
                },
                {
                  "text": " Không khí luôn trong lành, giàu Oxy, hoàn toàn không có mùi ẩm mốc hay bụi bặm.",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "type": "listItem",
          "content": [
            {
              "type": "paragraph",
              "content": [
                {
                  "text": "Hiệu suất xanh:",
                  "type": "text",
                  "marks": [
                    {
                      "type": "bold"
                    }
                  ]
                },
                {
                  "text": " Hệ thống vận hành êm ái và tiết kiệm hơn ",
                  "type": "text"
                },
                {
                  "text": "30%",
                  "type": "text",
                  "marks": [
                    {
                      "type": "bold"
                    }
                  ]
                },
                {
                  "text": " năng lượng nhờ công nghệ biến tần tối ưu.",
                  "type": "text"
                }
              ]
            }
          ]
        }
      ]
