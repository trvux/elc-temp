    {
      "type": "paragraph",
      "content": [
        {
          "text": "Dự án tại ",
          "type": "text"
        },
        {
          "text": "The River Thủ Thiêm",
          "type": "text",
          "marks": [
            {
              "type": "bold"
            }
          ]
        },
        {
          "text": " một lần nữa khẳng định năng lực của Điện máy ELC trong việc cung cấp giải pháp khí tươi chuyên sâu cho các căn hộ hạng sang. Chúng tôi cam kết:",
          "type": "text"
        }
      ]
