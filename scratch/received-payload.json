    {
      "type": "paragraph",
      "content": [
        {
          "text": "Quy trình thực thi chuẩn Kỹ thuật",
          "type": "text",
          "marks": [
            {
              "type": "bold"
            }
          ]
        }
      ]
    },
    {
      "type": "paragraph",
      "content": [
        {
          "text": "Quá trình triển khai tại ",
          "type": "text"
        },
        {
          "text": "Thành phố Thủ dầu Một",
          "type": "text",
          "marks": [
            {
              "type": "bold"
            }
          ]
        },
        {
          "text": " được kiểm soát nghiêm ngặt qua 4 giai đoạn:",
          "type": "text"
        }
      ]
    },
    {
      "type": "orderedList",
      "attrs": {
        "type": null,
        "start": 1
      },
      "content": [
        {
          "type": "listItem",
          "content": [
            {
              "type": "paragraph",
              "content": [
                {
                  "text": "Khảo sát & Mô phỏng 3D:",
                  "type": "text",
                  "marks": [
                    {
                      "type": "bold"
                    }
                  ]
                },
                {
                  "text": " Tính toán vị trí miệng gió chuẩn xác theo bản vẽ nội thất để không làm phá vỡ cấu trúc trần.",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "type": "listItem",
          "content": [
            {
              "type": "paragraph",
              "content": [
                {
                  "text": "Lắp đặt phần thô (Rough-in):",
                  "type": "text",
                  "marks": [
                    {
                      "type": "bold"
                    }
                  ]
                },
                {
                  "text": " Đi đường ống đồng, ống thoát nước ngưng và hệ thống ống gió kháng khuẩn.",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "type": "listItem",
          "content": [
            {
              "type": "paragraph",
              "content": [
                {
                  "text": "Kết nối & Cấu hình:",
                  "type": "text",
                  "marks": [
                    {
                      "type": "bold"
                    }
                  ]
                },
                {
                  "text": " Lắp đặt dàn nóng/lạnh và bộ lọc trung tâm. Cấu hình hệ thống điều khiển thông minh tập trung.",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "type": "listItem",
          "content": [
            {
              "type": "paragraph",
              "content": [
                {
                  "text": "Kiểm soát chất lượng (QC):",
                  "type": "text",
                  "marks": [
                    {
                      "type": "bold"
                    }
                  ]
                },
                {
                  "text": " Sử dụng thiết bị chuyên dụng đo lưu lượng gió, áp suất gas và độ ồn vận hành thực tế trước khi bàn giao.",
                  "type": "text"
                }
              ]
            }
          ]
        }
      ]
    },
