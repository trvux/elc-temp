ror) {\n    console.error(\"[loginAction] Step 2/3 - Exception caught in loginAction:\", error);\n    return {\n      data: null,\n      error: error instanceof Error ? error.message : \"Đã có lỗi xảy ra\",\n    };\n  }\n}\n\nexport async function logoutAction() {\n  try {\n    const { error } = await logout();\n    if (error) {\n      return { success: false, error };\n    }\n\n    revalidatePath(\"/\", \"layout\");\n    return { success: true, error: null };\n  } catch (error) {\n    console.error(\"logoutAction error:\", error);\n    return {\n      success: false,\n      error: error instanceof Error ? error.message : \"Đã có lỗi xảy ra\",\n    };\n  }\n}\n","usedDeprecatedRules":[]},{"filePath":"/Users/tranvux/Documents/elc-tem/modules/auth/server.ts","messages":[],"suppressedMessages":[],"errorCount":0,"fatalErrorCount":0,"warningCount":0,"fixableErrorCount":0,"fixableWarningCount":0,"usedDeprecatedRules":[]},{"filePath":"/Users/tranvux/Documents/elc-tem/modules/branch/__tests__/application/branchUseCases.test.ts","messages":[],"suppressedMessages":[],"errorCount":0,"fatalErrorCount":0,"warningCount":0,"fixableErrorCount":0,"fixableWarningCount":0,"usedDeprecatedRules":[]},{"filePath":"/Users/tranvux/Documents/elc-tem/modules/branch/__tests__/domain/mocks.test.ts","messages":[],"suppressedMessages":[],"errorCount":0,"fatalErrorCount":0,"warningCount":0,"fixableErrorCount":0,"fixableWarningCount":0,"usedDeprecatedRules":[]},{"filePath":"/Users/tranvux/Documents/elc-tem/modules/branch/__tests__/infrastructure/branchRepo.test.ts","messages":[],"suppressedMessages":[],"errorCount":0,"fatalErrorCount":0,"warningCount":0,"fixableErrorCount":0,"fixableWarningCount":0,"usedDeprecatedRules":[]},{"filePath":"/Users/tranvux/Documents/elc-tem/modules/branch/application/countBranches.ts","messages":[],"suppressedMessages":[],"errorCount":0,"fatalErrorCount":0,"warningCount":0,"fixableErrorCount":0,"fixableWarningCount":0,"usedDeprecatedRules":[]},{"filePath":"/Users/tranvu